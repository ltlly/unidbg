+/* Exact-size backing reuse preserves the allocator's trailing guard page.
+ * The charge includes one host page per allocation and is capped at 64 KiB.
+ * RAMBlock/MemoryRegion ownership, unmapping and TLB/TB invalidation are unchanged.
+ */
+static void *ram_cache_take(struct uc_struct *uc, size_t size, uint64_t *align)
+{
+    size_t i;
+    if (uc->ram_cache_closing) {
+        return NULL;
+    }
+    for (i = 0; i < 8; i++) {
+        if (uc->ram_cache[i].host && uc->ram_cache[i].size == size) {
+            void *host = uc->ram_cache[i].host;
+            *align = uc->ram_cache[i].align;
+            uc->ram_cache[i].host = NULL;
+            uc->ram_cache_bytes -= size + uc->qemu_host_page_size;
+            memset(host, 0, size);
+            return host;
+        }
+    }
+    return NULL;
+}
+
+static bool ram_cache_put(struct uc_struct *uc, RAMBlock *block)
+{
+    size_t i, charge;
+    if (uc->ram_cache_closing || !block->host ||
+        block->max_length > 64 * 1024 || uc->qemu_host_page_size > 64 * 1024) {
+        return false;
+    }
+    charge = block->max_length + uc->qemu_host_page_size;
+    if (charge > 64 * 1024 - uc->ram_cache_bytes) {
+        return false;
+    }
+    for (i = 0; i < 8; i++) {
+        if (!uc->ram_cache[i].host) {
+            uc->ram_cache[i].host = block->host;
+            uc->ram_cache[i].size = block->max_length;
+            uc->ram_cache[i].align = block->mr->align;
+            uc->ram_cache_bytes += charge;
+            return true;
+        }
+    }
+    return false;
+}
+
