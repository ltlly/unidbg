+/* Match the shallow filtering performed by uc_restore_latest_snapshot. */
+static bool snapshot_root_survives(MemoryRegion *mr, int level)
+{
+    MemoryRegion *child;
+    if (mr->priority >= level) {
+        return false;
+    }
+    if (mr->terminates) {
+        return true;
+    }
+    QTAILQ_FOREACH(child, &mr->subregions, subregions_link) {
+        if (child->priority < level) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool snapshot_roots_overlap(MemoryRegion *a, MemoryRegion *b)
+{
+    /* A legal nonempty mapping may end exactly at 2^64 (end == 0). */
+    return a->addr <= b->end - 1 && b->addr <= a->end - 1;
+}
+
+static uc_err snapshot_restore_preflight(uc_engine *uc, int level)
+{
+    size_t first = uc->unmapped_regions->len;
+    size_t required = uc->mapped_block_count;
+    MemoryRegion *root, *other;
+    while (first > 0) {
+        root = g_array_index(uc->unmapped_regions, MemoryRegion *, first - 1);
+        if ((intptr_t)root->container < level) {
+            break;
+        }
+        first--;
+    }
+    for (size_t i = first; i < uc->unmapped_regions->len; i++) {
+        root = g_array_index(uc->unmapped_regions, MemoryRegion *, i);
+        if (!snapshot_root_survives(root, level)) {
+            continue;
+        }
+        QTAILQ_FOREACH(other, &uc->system_memory->subregions, subregions_link) {
+            if (snapshot_root_survives(other, level) &&
+                snapshot_roots_overlap(root, other)) {
+                return UC_ERR_MAP;
+            }
+        }
+        for (size_t j = first; j < i; j++) {
+            other = g_array_index(uc->unmapped_regions, MemoryRegion *, j);
+            if (snapshot_root_survives(other, level) &&
+                snapshot_roots_overlap(root, other)) {
+                return UC_ERR_MAP;
+            }
+        }
+        if (required == SIZE_MAX) {
+            return UC_ERR_NOMEM;
+        }
+        required++;
+    }
+    /* No insertion needs no additional capacity. */
+    if (required == uc->mapped_block_count) {
+        return UC_ERR_OK;
+    }
+    /* Reserve before publishing a saved view or filtering any roots. */
+    return mem_map_reserve(uc, required);
+}
