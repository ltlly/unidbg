+/* Geometric validation is not a repair for broken membership: add/free must
+ * keep exactly the same live blocks in both lists. The original scan remains
+ * the fallback for overflow, overlapping identities or a missing index. */
+static ram_addr_t find_ram_offset(struct uc_struct *uc, ram_addr_t size)
+{
+    RAMBlock *block, *prev = NULL, *next;
+    ram_addr_t prior_end = 0, mingap = RAM_ADDR_MAX;
+    ram_addr_t alignment = (ram_addr_t)BITS_PER_LONG << TARGET_PAGE_BITS;
+
+    assert(size != 0);
+    if (!uc->ram_list.freed || QLIST_EMPTY_RCU(&uc->ram_list.blocks) ||
+        !uc->ram_list.addr_head || !uc->ram_list.addr_tail) {
+        return find_ram_offset_slow(uc, size);
+    }
+    for (block = uc->ram_list.addr_head; block; block = block->addr_next) {
+        if (block->addr_prev != prev || !block->max_length ||
+            block->max_length > RAM_ADDR_MAX - block->offset ||
+            (prev && block->offset < prior_end)) {
+            return find_ram_offset_slow(uc, size);
+        }
+        prior_end = block->offset + block->max_length;
+        prev = block;
+    }
+    if (prev != uc->ram_list.addr_tail) {
+        return find_ram_offset_slow(uc, size);
+    }
+
+    next = uc->ram_list.addr_head;
+    prev = NULL;
+    for (block = uc->ram_list.addr_head; block; block = block->addr_next) {
+        ram_addr_t candidate = block->offset + block->max_length;
+        ram_addr_t limit;
+        block->gap_scratch = 0;
+        if (candidate > RAM_ADDR_MAX - (alignment - 1)) {
+            continue;
+        }
+        candidate = ROUND_UP(candidate, alignment);
+        while (next && next->offset < candidate) {
+            prev = next;
+            next = next->addr_next;
+        }
+        if (prev && candidate - prev->offset < prev->max_length) {
+            continue;
+        }
+        limit = next ? next->offset : RAM_ADDR_MAX;
+        block->gap_scratch = limit - candidate;
+        if (block->gap_scratch >= size && block->gap_scratch < mingap) {
+            mingap = block->gap_scratch;
+        }
+    }
+    if (mingap != RAM_ADDR_MAX) {
+        /* Preserve the original size-list tie order, not address order. */
+        RAMBLOCK_FOREACH(block) {
+            if (block->gap_scratch >= size && block->gap_scratch == mingap) {
+                return ROUND_UP(block->offset + block->max_length, alignment);
+            }
+        }
+    }
+    return find_ram_offset_slow(uc, size);
+}
