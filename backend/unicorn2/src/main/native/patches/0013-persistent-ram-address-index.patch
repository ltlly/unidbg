+/* Keep a second ordering without changing the size-sorted primary list.
+ * Only successful RAMBlock publication and actual destruction change membership.
+ * Snapshot moveout/restore must not roll this live-block index back. */
+static void ram_address_insert(struct uc_struct *uc, RAMBlock *block)
+{
+    RAMBlock *next = uc->ram_list.addr_head;
+    RAMBlock *prev = NULL;
+    if (uc->ram_list.addr_tail &&
+        uc->ram_list.addr_tail->offset <= block->offset) {
+        prev = uc->ram_list.addr_tail;
+        next = NULL;
+    } else {
+        while (next && next->offset <= block->offset) {
+            prev = next;
+            next = next->addr_next;
+        }
+    }
+    block->addr_prev = prev;
+    block->addr_next = next;
+    if (prev) {
+        prev->addr_next = block;
+    } else {
+        uc->ram_list.addr_head = block;
+    }
+    if (next) {
+        next->addr_prev = block;
+    } else {
+        uc->ram_list.addr_tail = block;
+    }
+}
+
+static void ram_address_remove(struct uc_struct *uc, RAMBlock *block)
+{
+    if (block->addr_prev) {
+        block->addr_prev->addr_next = block->addr_next;
+    } else {
+        uc->ram_list.addr_head = block->addr_next;
+    }
+    if (block->addr_next) {
+        block->addr_next->addr_prev = block->addr_prev;
+    } else {
+        uc->ram_list.addr_tail = block->addr_prev;
+    }
+    block->addr_prev = block->addr_next = NULL;
+}
