+#if defined(TARGET_ARM) && !defined(TARGET_AARCH64) && UINTPTR_MAX == UINT64_MAX
+/* Keep the original per-store exit boundary, with the true JIT return PC.
+ * A normal C call to helper_check_exit_request would capture the wrong PC. */
+QEMU_NOINLINE void uc_push_exit_arm(struct uc_struct *uc, uintptr_t retaddr)
+{
+    if (cpu_loop_exit_requested(uc->cpu)) {
+        if (uc->nested_level == 1) {
+            tb_exec_unlock(uc);
+        }
+        uc->cpu->tcg_exit_req = 0;
+        if (uc->skip_sync_pc_on_exit) {
+            uc->skip_sync_pc_on_exit = false;
+            cpu_loop_exit(uc->cpu);
+        } else {
+            cpu_loop_exit_restore(uc->cpu, retaddr);
+        }
+    }
+}
+
+uint32_t HELPER(push_try_arm)(CPUArchState *env, uint32_t address,
+                              uint32_t list, uint32_t mmu_idx)
+{
+    struct uc_struct *uc = env->uc;
+    target_ulong addr = address;
+    unsigned n = ctpop16(list);
+    CPUTLBEntry *entry;
+    CPUIOTLBEntry *io;
+    MemoryRegion *mr;
+    uintptr_t retaddr = GETPC();
+    uintptr_t host;
+    unsigned i;
+
+    /* No store has happened on any fallback return. */
+    if (n < 2 || (list & ~0x5fffU) || (addr & 3) ||
+        (addr & ~TARGET_PAGE_MASK) > TARGET_PAGE_SIZE - 4 * n ||
+        uc->snapshot_level || HOOK_EXISTS(uc, UC_HOOK_MEM_WRITE) ||
+        uc->stop_request || uc->invalid_error || cpu_loop_exit_requested(uc->cpu)) {
+        return 0;
+    }
+    entry = tlb_entry(env, mmu_idx, addr);
+    if (tlb_addr_write(entry) != ((addr & TARGET_PAGE_MASK) | TLB_NOTDIRTY) ||
+        entry->addr_code == (target_ulong)-1) {
+        return 0;
+    }
+    io = &env_tlb(env)->d[mmu_idx].iotlb[tlb_index(env, mmu_idx, addr)];
+    if (io->ram_section_index == UINT32_MAX) {
+        return 0;
+    }
+    mr = memory_region_from_cached_ram_section(uc, io->ram_section_index);
+    if (!mr || !mr->ram || mr->readonly || !(mr->perms & UC_PROT_WRITE) ||
+        (mr->perms & UC_PROT_EXEC)) {
+        return 0;
+    }
+
+    /* Under these guards notdirty_write has neither invalidation nor tag
+     * cleanup effects. Do not clear NOTDIRTY: future hooks must still work. */
+    host = (uintptr_t)addr + entry->addend;
+    for (i = 0; i < 15; i++) {
+        if (list & (1U << i)) {
+            stl_le_p((void *)host, env->regs[i]);
+            uc_push_exit_arm(uc, retaddr);
+            host += 4;
+        }
+    }
+    return 1;
+}
+#endif
