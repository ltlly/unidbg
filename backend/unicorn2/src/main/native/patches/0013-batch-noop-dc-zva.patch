+#if defined(TARGET_AARCH64) && UINTPTR_MAX == UINT64_MAX
+/* DC ZVA may retain NOTDIRTY even on non-executable RAM, because the raw
+ * code tag comes from the CPU MMU permissions rather than Unicorn's MR.
+ * In this narrow case each byte's notdirty_write is a no-op. Keep the tag:
+ * later hook registration and permission changes still need the slow path. */
+bool uc_try_dc_zva_ram_aarch64(CPUArchState *env, target_ulong addr,
+                              unsigned size, unsigned mmu_idx)
+{
+    struct uc_struct *uc = env->uc;
+    CPUTLBEntry *entry;
+    CPUIOTLBEntry *io;
+    MemoryRegion *mr;
+
+    if (uc->snapshot_level || HOOK_EXISTS(uc, UC_HOOK_MEM_WRITE) ||
+        uc->stop_request || uc->invalid_error != UC_ERR_OK ||
+        !size || size > TARGET_PAGE_SIZE ||
+        (addr & ~TARGET_PAGE_MASK) > TARGET_PAGE_SIZE - size) {
+        return false;
+    }
+    entry = tlb_entry(env, mmu_idx, addr);
+    if (tlb_addr_write(entry) != ((addr & TARGET_PAGE_MASK) | TLB_NOTDIRTY) ||
+        entry->addr_code == (target_ulong)-1) {
+        return false;
+    }
+    io = &env_tlb(env)->d[mmu_idx].iotlb[tlb_index(env, mmu_idx, addr)];
+    if (io->ram_section_index == UINT32_MAX) {
+        return false;
+    }
+    mr = memory_region_from_cached_ram_section(uc, io->ram_section_index);
+    if (!mr || !mr->ram || mr->readonly || !(mr->perms & UC_PROT_WRITE) ||
+        (mr->perms & UC_PROT_EXEC)) {
+        return false;
+    }
+    /* A cached RAM section covers the entire physical page. No callbacks,
+     * SMC invalidation or dirty-tag changes occur in the replaced byte loop. */
+    memset((void *)((uintptr_t)addr + entry->addend), 0, size);
+    return true;
+}
+#endif
