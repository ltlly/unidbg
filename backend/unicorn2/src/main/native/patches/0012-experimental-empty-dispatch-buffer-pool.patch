+static bool dispatch_cache_admissible(AddressSpaceDispatch *d)
+{
+    struct uc_struct *uc = d->uc;
+    size_t remaining = 65536 - sizeof(*d);
+    if (!uc->init_done || uc->ram_cache_closing || uc->snapshot_level != 0 ||
+        uc->dispatch_cache) {
+        return false;
+    }
+    if (d->map.sections_nb_alloc > remaining / sizeof(*d->map.sections)) {
+        return false;
+    }
+    remaining -= d->map.sections_nb_alloc * sizeof(*d->map.sections);
+    return d->map.nodes_nb_alloc <= remaining / sizeof(*d->map.nodes);
+}
+
 void address_space_dispatch_free(AddressSpaceDispatch *d)
 {
+    if (dispatch_cache_admissible(d)) {
+        /* Destruction is unchanged: no MemoryRegion or subpage survives. */
+        phys_sections_destroy(&d->map);
+        d->map.nodes_nb = 0;
+        d->mru_section = NULL;
+        d->phys_map = (PhysPageEntry) { .ptr = PHYS_MAP_NODE_NIL, .skip = 1 };
+        d->uc->dispatch_cache = d;
+        return;
+    }
     phys_sections_free(&d->map);
     g_free(d);
 }
